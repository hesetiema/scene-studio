{
  "name": "scene-studio",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:visual": "playwright test --config e2e/playwright.config.ts visual",
    "test:perf": "playwright test --config e2e/playwright.config.ts --project=perf --no-deps",
    "test:pack": "node scripts/pack-smoke.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
